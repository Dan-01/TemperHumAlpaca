<ResourceDictionary
    x:Class="TemperHumAlpaca.NinaPlugin.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="TemperHumAlpaca_Options">
        <StackPanel Margin="12" MaxWidth="760">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="TemperHumAlpaca" />
            <TextBlock Margin="0,4,0,14" TextWrapping="Wrap"
                       Text="The N.I.N.A. panel reads TemperHumAlpaca's loopback API. The Windows service remains the source of truth for the USB sensor, dew calculations and overnight forecast." />

            <TextBlock FontWeight="SemiBold" Text="Local service URL" />
            <TextBox Margin="0,4,0,12" Text="{Binding ServiceUrl, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Panel refresh interval (seconds)" />
                <TextBox Grid.Column="1" Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=LostFocus}" />
            </Grid>

            <Separator Margin="0,4,0,12" />
            <TextBlock Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold" Text="Alert rules" />
            <CheckBox Margin="0,0,0,10" Content="Enable N.I.N.A. dew alerts" IsChecked="{Binding AlertsEnabled}" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Alert when dew risk reaches" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding AlertRiskLevels}" SelectedItem="{Binding AlertRiskLevel}" />
            </Grid>

            <CheckBox Margin="0,0,0,8" Content="Alert if the overnight heater recommendation increases" IsChecked="{Binding AlertOnHeaterIncrease}" />
            <CheckBox Margin="0,0,0,8" Content="Alert if the TEMPerHUM sensor disconnects" IsChecked="{Binding AlertOnSensorDisconnect}" />
            <CheckBox Margin="0,0,0,12" Content="Alert if the TemperHumAlpaca service becomes unavailable" IsChecked="{Binding AlertOnServiceLoss}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Repeat-alert cooldown (minutes)" />
                <TextBox Grid.Column="1" Text="{Binding AlertCooldownMinutes, UpdateSourceTrigger=LostFocus}" />
            </Grid>

            <Separator Margin="0,16,0,12" />
            <TextBlock Margin="0,0,0,4" FontSize="16" FontWeight="SemiBold" Text="Telegram remote alerts" />
            <TextBlock Margin="0,0,0,10" TextWrapping="Wrap"
                       Text="Send the same transition-based dew/heater/service alerts directly through your Telegram bot. You can use the same bot token and chat ID as Ground Station; Ground Station itself is not required for these messages." />

            <CheckBox Margin="0,0,0,12" Content="Enable Telegram delivery" IsChecked="{Binding TelegramEnabled}" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Telegram chat ID" />
                <TextBox Grid.Column="1" Text="{Binding TelegramChatId, UpdateSourceTrigger=LostFocus}" />
            </Grid>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Telegram bot token" />
                <PasswordBox Grid.Column="1" LostKeyboardFocus="TelegramBotToken_LostKeyboardFocus" />
            </Grid>

            <TextBlock Margin="220,0,0,10" Text="{Binding TelegramTokenStatus}" TextWrapping="Wrap" />

            <StackPanel Margin="220,0,0,8" Orientation="Horizontal">
                <Button MinWidth="120" Margin="0,0,8,0" Content="Test Telegram" Command="{Binding TestTelegramCommand}" />
                <Button MinWidth="150" Content="Clear stored bot token" Command="{Binding ClearTelegramBotTokenCommand}" />
            </StackPanel>

            <TextBlock Margin="220,0,0,0" Text="{Binding TelegramTestStatus}" TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
