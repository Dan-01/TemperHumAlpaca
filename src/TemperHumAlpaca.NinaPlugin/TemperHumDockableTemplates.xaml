<ResourceDictionary
    x:Class="TemperHumAlpaca.NinaPlugin.TemperHumDockableTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="TemperHumAlpaca.NinaPlugin.TemperHumDockable_Dockable">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="TEMPerHUM Dew Monitor" />
                        <TextBlock FontSize="11" Opacity="0.7" Text="{Binding ServiceStatus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button MinWidth="70" Margin="4,0" Padding="8,4" Command="{Binding RefreshCommand}" Content="Refresh" />
                        <Button MinWidth="105" Margin="4,0,0,0" Padding="8,4" Command="{Binding OpenDashboardCommand}" Content="Open dashboard" />
                    </StackPanel>
                </Grid>

                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <Border Margin="3" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                        <StackPanel><TextBlock FontSize="11" Opacity="0.7" Text="Temperature"/><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Temperature}"/></StackPanel>
                    </Border>
                    <Border Margin="3" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                        <StackPanel><TextBlock FontSize="11" Opacity="0.7" Text="Humidity"/><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Humidity}"/></StackPanel>
                    </Border>
                    <Border Margin="3" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                        <StackPanel><TextBlock FontSize="11" Opacity="0.7" Text="Dew point"/><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding DewPoint}"/></StackPanel>
                    </Border>
                    <Border Margin="3" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                        <StackPanel><TextBlock FontSize="11" Opacity="0.7" Text="Dew margin"/><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding DewMargin}"/><TextBlock FontSize="11" Opacity="0.7" Text="{Binding Trend}"/></StackPanel>
                    </Border>
                </UniformGrid>

                <Border Margin="3,0,3,8" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="11" Opacity="0.7" Text="Dew risk" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding DewRisk}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="11" Opacity="0.7" Text="AstroZap estimate now" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding CurrentHeater}" />
                            <TextBlock FontSize="11" Opacity="0.7" Text="{Binding CurrentKnob}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="3,0,3,8" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Overnight set-and-leave" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="11" Opacity="0.7" Text="Heater setting" />
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding OvernightHeater}" />
                                <TextBlock FontSize="11" Opacity="0.7" Text="{Binding OvernightKnob}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="11" Opacity="0.7" Text="Conservative minimum" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding ForecastMinimum}" />
                                <TextBlock FontSize="11" Opacity="0.7" Text="{Binding ForecastWorstTime}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,8,0,0" FontSize="11" Opacity="0.75" TextWrapping="Wrap" Text="{Binding ForecastDetail}" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="3,0" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Text="{Binding LastUpdated}" />
                <TextBlock Margin="3,4,3,0" FontSize="11" TextWrapping="Wrap" Text="{Binding LastError}" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
